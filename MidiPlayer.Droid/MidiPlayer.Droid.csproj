<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MidiPlayer.Droid - .NET 10 for Android
    Replaces the legacy Xamarin.Android project (ToolsVersion="4.0", TargetFrameworkVersion v10.0).
  -->

  <PropertyGroup>
    <!-- Application identity -->
    <ApplicationId>com.studio.meowtoon.midiplayer</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- Build target: net10.0-android replaces the old Xamarin TargetFrameworkVersion v10.0 -->
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- OutputType Exe is required for Android application projects in .NET SDK style -->
    <OutputType>Exe</OutputType>
    <!-- Project identity -->
    <RootNamespace>MidiPlayer.Droid</RootNamespace>
    <AssemblyName>MidiPlayer.Droid</AssemblyName>
    <!-- Android manifest path -->
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <!-- Minimum Android API level (minSdkVersion); must be <= TargetPlatformVersion -->
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <!-- Target Android API level; must be >= SupportedOSPlatformVersion -->
    <TargetPlatformVersion>36.1</TargetPlatformVersion>
    <!-- Language and build options -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <!-- Android runtime options -->
    <AndroidEnableSGenConcurrent>true</AndroidEnableSGenConcurrent>
  </PropertyGroup>

  <!-- Debug configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <AndroidLinkMode>None</AndroidLinkMode>
    <EmbedAssembliesIntoApk>false</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <!-- Release configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <AndroidManagedSymbols>true</AndroidManagedSymbols>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <!-- Exclude legacy AssemblyInfo.cs: SDK-style projects auto-generate assembly attributes from csproj properties -->
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- Android environment variables injected at startup -->
  <ItemGroup>
    <AndroidEnvironment Include="env.conf" />
  </ItemGroup>

  <!--
    Native FluidSynth shared libraries.
    AndroidNativeLibrary items are NOT auto-discovered by the SDK and must be listed explicitly.
    Wildcard glob patterns replace the previous 44 individual entries in the legacy csproj.
  -->
  <ItemGroup>
    <!-- arm64-v8a (64-bit ARM, primary device target) -->
    <AndroidNativeLibrary Include="libs\arm64-v8a\*.so">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AndroidNativeLibrary>
    <!-- armeabi-v7a (32-bit ARM, legacy device support) -->
    <AndroidNativeLibrary Include="libs\armeabi-v7a\*.so">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AndroidNativeLibrary>
    <!-- x86 (32-bit emulator) -->
    <AndroidNativeLibrary Include="libs\x86\*.so">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AndroidNativeLibrary>
    <!-- x86_64 (64-bit emulator) -->
    <AndroidNativeLibrary Include="libs\x86_64\*.so">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AndroidNativeLibrary>
  </ItemGroup>

  <!--
    NuGet packages.
    Xamarin.Android.Support.* and Xamarin.Essentials are removed.
    Replaced with their AndroidX equivalents; MAUI Essentials is provided via UseMauiEssentials above.
  -->
  <ItemGroup>
    <!-- AndroidX AppCompat: provides AppCompatActivity and ActionBar support -->
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.0.6" />
    <!-- AndroidX Core: provides ContextCompat.CheckSelfPermission and ActivityCompat.RequestPermissions -->
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.16.0.1" />
    <!-- Material Design components: provides the activity theme declared in AndroidManifest.xml -->
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.12.0.3" />
  </ItemGroup>

  <!-- Project references (Project GUIDs are omitted in SDK-style csproj) -->
  <ItemGroup>
    <ProjectReference Include="..\MidiPlayer.FluidSynth\MidiPlayer.FluidSynth.csproj" />
    <ProjectReference Include="..\MidiPlayer\MidiPlayer.csproj" />
  </ItemGroup>

</Project>
